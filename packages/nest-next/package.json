{
  "name": "@newt-app/nest-next",
  "version": "1.0.0",
  "description": "Run a full NestJS HTTP application inside a Next.js API route.",
  "license": "MIT",
  "author": "Shane O'Neill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeevo/newt-app.git",
    "directory": "packages/nest-next"
  },
  "homepage": "https://newt-app.com",
  "bugs": {
    "url": "https://github.com/zeevo/newt-app/issues"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@newt-app/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "oxlint": "^1.74.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsdown": "^0.22.14",
    "typescript": "6.0.2",
    "vitest": "^4.1.2"
  }
}
