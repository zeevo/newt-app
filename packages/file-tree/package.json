{
  "name": "@newt-app/file-tree",
  "version": "0.0.0",
  "description": "A file tree for documenting project structure, styled with Tailwind and shadcn/ui tokens.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@newt-app/eslint-config": "workspace:*",
    "@newt-app/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.14",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^29.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsdown": "^0.22.14",
    "typescript": "6.0.2",
    "vitest": "^4.1.2"
  }
}
