{
  "name": "@my-app/auth",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- auth generate --config src/index.ts",
    "migrate": "dotenv -e ../../.env -- auth migrate -y --config src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@my-app/db": "workspace:*",
    "auth": "^1.5.5",
    "better-auth": "^1.2.8"
  },
  "devDependencies": {
    "@my-app/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "typescript": "6.0.2"
  }
}
