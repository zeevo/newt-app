{
  "include": ["src/**/*.ts"],
  // the vendored plugin typechecks against oxlint types this package does not install
  "exclude": ["node_modules", "dist", "src/templates/anti-slop/static"],
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "outDir": "./dist",
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true
  }
}
